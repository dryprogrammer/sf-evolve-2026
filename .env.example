# Demo identities are not authentication. Keep this pilot private/local.
FACTORY_MODE=fixture
# Optional absolute directory for persistent embedded PostgreSQL data.
# FACTORY_DATA_DIR=/absolute/path/to/factory-data

# Optional server-only authoritative evidence (demo identity remains fixture mode).
# Never put the key in NEXT_PUBLIC_*, client code or committed environment files.
FACTORY_SOURCE=fixture
FACTORY_WORK_ORDER_ID=
FACTORY_SUPPLEMENTAL_IDS=
# FACTORY_API_KEY is supplied only by secure workspace settings.
